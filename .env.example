# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI / LLM ---
# LLM_PROVIDER selects the active provider in ai-service. "nvidia" | "grok"
LLM_PROVIDER=nvidia

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Alternative LLM provider (set LLM_PROVIDER=openrouter). Fast for the voice companion.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
NVIDIA_MODEL=openai/gpt-oss-20b

# Vision model for "find this" and the screen assistant (reads screenshots). Must accept images and exist on the
# provider selected above. Empty = a default for the provider (NVIDIA: meta/llama-3.2-90b-vision-instruct, Grok:
# grok-2-vision-latest, OpenRouter: its main model, fine for Claude). Hosted models get retired: set this if the default is gone.
VISION_MODEL=

GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# --- Voice ---
# VOICE_PROVIDER selects the active provider in both backend and ai-service. "gemini" | "elevenlabs"
VOICE_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE_NAME=Kore

VAPI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Shopping & Travel (SerpAPI: Google Shopping, Google Flights, Google Hotels) ---
# One key covers all three engines. (Amadeus's self-serve developer portal
# was decommissioned in July 2026 — its replacement requires a business
# agreement, so SerpAPI is used for travel too instead of a second key.)
SERPAPI_API_KEY=

# --- Google OAuth (Sign in with Google + Calendar) ---
# Configured in Supabase Dashboard -> Authentication -> Providers -> Google,
# not read directly by these services.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Service URLs (docker-compose overrides PYTHON_AI_URL automatically) ---
NODE_API_URL=http://localhost:4000
PYTHON_AI_URL=http://localhost:8000

# --- Backend ---
PORT=4000
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Optional ---
REDIS_URL=
NODE_ENV=development
